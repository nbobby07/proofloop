# Copy to .env; never place provider secrets in frontend VITE_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=
AKASH_API_KEY=
AKASH_MODEL=
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=true
SENSO_API_KEY=
SENSO_ORG_ID=
GUILD_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
PROOFLOOP_ENV=development
PROOFLOOP_BACKEND_HOST=127.0.0.1
PROOFLOOP_BACKEND_PORT=8000
PROOFLOOP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PROOFLOOP_FRONTEND_HOST=localhost
PROOFLOOP_FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# Execution is opt-in. Pin the reviewed local image and trusted suite manifest.
PROOFLOOP_EXECUTION_ENABLED=0
PROOFLOOP_VERIFIER_IMAGE=
PROOFLOOP_MANIFEST_SHA256=
PROOFLOOP_DOCKER_HOST=unix:///var/run/docker.sock
PROOFLOOP_RUNS_DIR=runs
SEMGREP_EXECUTABLE=semgrep

# Optional trusted CA bundle if the local Python install lacks one; never disable TLS.
# SSL_CERT_FILE=/etc/ssl/cert.pem

# Optional durable-event delivery; initialize schema explicitly before enabling.
PROOFLOOP_TELEMETRY_ENABLED=0
CLICKHOUSE_DATABASE=default

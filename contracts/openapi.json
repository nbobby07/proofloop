{
  "components": {
    "schemas": {
      "AnalyticsResponse": {
        "additionalProperties": false,
        "properties": {
          "failure_patterns": {
            "items": {
              "$ref": "#/components/schemas/FailurePattern"
            },
            "title": "Failure Patterns",
            "type": "array"
          },
          "rejected_count": {
            "minimum": 0.0,
            "title": "Rejected Count",
            "type": "integer"
          },
          "run_count": {
            "minimum": 0.0,
            "title": "Run Count",
            "type": "integer"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "verified_count": {
            "minimum": 0.0,
            "title": "Verified Count",
            "type": "integer"
          }
        },
        "required": [
          "source",
          "run_count",
          "verified_count",
          "rejected_count",
          "failure_patterns"
        ],
        "title": "AnalyticsResponse",
        "type": "object"
      },
      "BaselineResult": {
        "additionalProperties": false,
        "properties": {
          "observed_status": {
            "anyOf": [
              {
                "maximum": 599.0,
                "minimum": 100.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observed Status"
          },
          "reproduced": {
            "title": "Reproduced",
            "type": "boolean"
          }
        },
        "required": [
          "reproduced"
        ],
        "title": "BaselineResult",
        "type": "object"
      },
      "BriefingRequest": {
        "additionalProperties": false,
        "description": "Only the expected evidence identity, never arbitrary narration text.",
        "properties": {
          "report_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Report Sha256",
            "type": "string"
          }
        },
        "required": [
          "report_sha256"
        ],
        "title": "BriefingRequest",
        "type": "object"
      },
      "BriefingResponse": {
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Artifact Id"
          },
          "audio_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Audio Path"
          },
          "report_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Report Sha256",
            "type": "string"
          },
          "run_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Run Id",
            "type": "string"
          },
          "source": {
            "const": "execution",
            "default": "execution",
            "title": "Source",
            "type": "string"
          },
          "status": {
            "enum": [
              "unavailable",
              "not_generated",
              "generating",
              "ready",
              "error"
            ],
            "title": "Status",
            "type": "string"
          },
          "transcript": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Transcript"
          }
        },
        "required": [
          "run_id",
          "status",
          "report_sha256"
        ],
        "title": "BriefingResponse",
        "type": "object"
      },
      "ChallengeRequest": {
        "additionalProperties": false,
        "properties": {
          "max_challenges": {
            "default": 2,
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Max Challenges",
            "type": "integer"
          },
          "policy_ids": {
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            "maxItems": 20,
            "title": "Policy Ids",
            "type": "array"
          }
        },
        "title": "ChallengeRequest",
        "type": "object"
      },
      "ChallengeResponse": {
        "additionalProperties": false,
        "properties": {
          "run_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Run Id",
            "type": "string"
          },
          "source": {
            "const": "execution",
            "default": "execution",
            "title": "Source",
            "type": "string"
          },
          "status": {
            "const": "challenging",
            "default": "challenging",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "run_id"
        ],
        "title": "ChallengeResponse",
        "type": "object"
      },
      "CreateRunRequest": {
        "additionalProperties": false,
        "properties": {
          "execution_mode": {
            "default": "local",
            "enum": [
              "local",
              "local_akash"
            ],
            "title": "Execution Mode",
            "type": "string"
          },
          "max_attempts": {
            "default": 3,
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Max Attempts",
            "type": "integer"
          },
          "target": {
            "enum": [
              "LedgerLite",
              "LedgerLite Workspace"
            ],
            "title": "Target",
            "type": "string"
          }
        },
        "required": [
          "target"
        ],
        "title": "CreateRunRequest",
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "not_implemented",
              "not_found",
              "invalid_request",
              "conflict",
              "internal_error"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "EventSeverity": {
        "enum": [
          "info",
          "warning",
          "error",
          "critical"
        ],
        "title": "EventSeverity",
        "type": "string"
      },
      "EventType": {
        "enum": [
          "provider_activity",
          "stage_started",
          "stage_completed",
          "finding_discovered",
          "baseline_reproduced",
          "patch_proposed",
          "patch_applied",
          "test_completed",
          "challenge_proposed",
          "retry_scheduled",
          "run_completed",
          "run_failed"
        ],
        "title": "EventType",
        "type": "string"
      },
      "EventsResponse": {
        "additionalProperties": false,
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/SecurityEvent"
            },
            "title": "Events",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "run_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Run Id",
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          }
        },
        "required": [
          "run_id",
          "source",
          "events"
        ],
        "title": "EventsResponse",
        "type": "object"
      },
      "EvidenceReference": {
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Artifact Id",
            "type": "string"
          },
          "description": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          }
        },
        "required": [
          "artifact_id",
          "sha256",
          "description"
        ],
        "title": "EvidenceReference",
        "type": "object"
      },
      "ExecutionDetails": {
        "additionalProperties": false,
        "properties": {
          "budget": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Budget",
            "type": "object"
          },
          "entries": {
            "items": {
              "additionalProperties": {
                "$ref": "#/components/schemas/JsonValue"
              },
              "type": "object"
            },
            "title": "Entries",
            "type": "array"
          },
          "execution_mode": {
            "enum": [
              "local",
              "local_akash"
            ],
            "title": "Execution Mode",
            "type": "string"
          },
          "run_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Run Id",
            "type": "string"
          },
          "source": {
            "const": "execution",
            "default": "execution",
            "title": "Source",
            "type": "string"
          },
          "target": {
            "title": "Target",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "target",
          "execution_mode"
        ],
        "title": "ExecutionDetails",
        "type": "object"
      },
      "FailurePattern": {
        "additionalProperties": false,
        "properties": {
          "challenge_family": {
            "title": "Challenge Family",
            "type": "string"
          },
          "executions": {
            "minimum": 0.0,
            "title": "Executions",
            "type": "integer"
          },
          "failures": {
            "minimum": 0.0,
            "title": "Failures",
            "type": "integer"
          }
        },
        "required": [
          "challenge_family",
          "failures",
          "executions"
        ],
        "title": "FailurePattern",
        "type": "object"
      },
      "Finding": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Id",
            "type": "string"
          },
          "severity": {
            "$ref": "#/components/schemas/FindingSeverity"
          },
          "title": {
            "maxLength": 300,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "severity"
        ],
        "title": "Finding",
        "type": "object"
      },
      "FindingSeverity": {
        "enum": [
          "info",
          "low",
          "medium",
          "high",
          "critical"
        ],
        "title": "FindingSeverity",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "service": {
            "const": "proofloop",
            "default": "proofloop",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "JsonValue": {},
      "PatchProposal": {
        "additionalProperties": false,
        "properties": {
          "attempt": {
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Attempt",
            "type": "integer"
          },
          "diff": {
            "maxLength": 200000,
            "minLength": 1,
            "title": "Diff",
            "type": "string"
          }
        },
        "required": [
          "attempt",
          "diff"
        ],
        "title": "PatchProposal",
        "type": "object"
      },
      "ReportResponse": {
        "additionalProperties": false,
        "properties": {
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/EvidenceReference"
            },
            "title": "Evidence",
            "type": "array"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "title": "Limitations",
            "type": "array"
          },
          "run_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Run Id",
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "summary": {
            "maxLength": 5000,
            "minLength": 1,
            "title": "Summary",
            "type": "string"
          },
          "verification": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VerificationSummary"

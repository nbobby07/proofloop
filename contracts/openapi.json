        },
        "required": [
          "run_id",
          "source",
          "status",
          "summary",
          "limitations"
        ],
        "title": "ReportResponse",
        "type": "object"
      },
      "RunResponse": {
        "additionalProperties": false,
        "properties": {
          "baseline": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BaselineResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/SecurityEvent"
            },
            "title": "Events",
            "type": "array"
          },
          "finding": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Finding"
              },
              {
                "type": "null"
              }
            ]
          },
          "patch": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PatchProposal"
              },
              {
                "type": "null"
              }
            ]
          },
          "run_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Run Id",
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "target": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Target",
            "type": "string"
          },
          "verification": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VerificationSummary"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "run_id",
          "status",
          "target",
          "source"
        ],
        "title": "RunResponse",
        "type": "object"
      },
      "RunStatus": {
        "enum": [
          "pending",
          "discovering",
          "reproducing",
          "generating_patch",
          "applying_patch",
          "verifying",
          "challenging",
          "retrying",
          "verified",
          "rejected",
          "inconclusive",
          "error"
        ],
        "title": "RunStatus",
        "type": "string"
      },
      "SecurityEvent": {
        "additionalProperties": false,
        "properties": {
          "event_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Event Id",
            "type": "string"
          },
          "event_type": {
            "$ref": "#/components/schemas/EventType"
          },
          "message": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "metadata": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Metadata",
            "type": "object"
          },
          "run_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Run Id",
            "type": "string"
          },
          "severity": {
            "$ref": "#/components/schemas/EventSeverity"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "stage": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          }
        },
        "required": [
          "event_id",
          "run_id",
          "timestamp",
          "stage",
          "event_type",
          "severity",
          "message",
          "source"
        ],
        "title": "SecurityEvent",
        "type": "object"
      },
      "Source": {
        "enum": [
          "fixture",
          "execution"
        ],
        "title": "Source",
        "type": "string"
      },
      "TelemetryAnalyticsResponse": {
        "additionalProperties": false,
        "description": "SQL results only; local fallback never masquerades as cloud telemetry.",
        "properties": {
          "analytics": {
            "$ref": "#/components/schemas/AnalyticsResponse"
          },
          "event_count": {
            "minimum": 0.0,
            "title": "Event Count",
            "type": "integer"
          },
          "incomplete_rounds": {
            "minimum": 0.0,
            "title": "Incomplete Rounds",
            "type": "integer"
          },
          "latest_event_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Event At"
          },
          "mean_patch_attempts": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mean Patch Attempts"
          },
          "mean_verification_duration_ms": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mean Verification Duration Ms"
          },
          "pending_events": {
            "minimum": 0.0,
            "title": "Pending Events",
            "type": "integer"
          },
          "query_ms": {
            "minimum": 0.0,
            "title": "Query Ms",
            "type": "number"
          },
          "source": {
            "const": "execution",
            "default": "execution",
            "title": "Source",
            "type": "string"
          },
          "storage": {
            "const": "clickhouse",
            "default": "clickhouse",
            "title": "Storage",
            "type": "string"
          }
